rules_version = '2';

// Regras de acesso do Silagem MS.
// Só pessoas autorizadas (administradores abaixo ou documentos em fazendas/<id>/membros/<e-mail>) leem e gravam.
// Papéis: admin (tudo, inclui pessoas) · membro (registra e exclui) · operador (consulta e registra, não exclui).
service cloud.firestore {
  match /databases/{db}/documents {

    // E-mails administradores (minúsculas). Mantenha igual a ADMINS em src/firebaseConfig.ts.
    function admins() {
      return ['marialauragcardoso@gmail.com', 'maria.mesquita@fazendavertente.com.br'];
    }

    function logado() {
      return request.auth != null && request.auth.token.email is string;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function docMembro(fid) {
      return /databases/$(db)/documents/fazendas/$(fid)/membros/$(email());
    }

    function ehMembro(fid) {
      return logado() && (email() in admins() || exists(docMembro(fid)));
    }

    // Papel efetivo: admins fixos são admin; os demais vêm do documento em membros.
    function papel(fid) {
      return email() in admins() ? 'admin' : get(docMembro(fid)).data.papel;
    }

    function ehAdmin(fid) {
      return ehMembro(fid) && papel(fid) == 'admin';
    }

    function podeExcluir(fid) {
      return ehMembro(fid) && papel(fid) != 'operador';
    }

    match /fazendas/{fid}/membros/{m} {
      allow read: if ehMembro(fid);
      allow create, update: if ehAdmin(fid)
        && m == m.lower()
        && request.resource.data.papel in ['admin', 'membro', 'operador']
        && request.resource.data.nome is string
        // Ninguém muda o próprio papel (evita um admin se rebaixar sem querer).
        && (m != email() || resource == null || request.resource.data.papel == resource.data.papel);
      // Um admin não remove a si mesmo (evita ficar sem acesso).
      allow delete: if ehAdmin(fid) && m != email();
    }

    // Pedidos de acesso: quem criou conta registra (e pode reenviar) o próprio pedido; só admins leem e apagam.
    match /fazendas/{fid}/solicitacoes/{m} {
      allow create, update: if logado()
        && m == email()
        && request.resource.data.email == email()
        && request.resource.data.nome is string
        && request.resource.data.em is string;
      allow read, delete: if ehAdmin(fid);
    }

    // Configurações compartilhadas (parâmetros da estimativa): todo membro lê; só administradores gravam.
    match /fazendas/{fid}/config/{docId} {
      allow read: if ehMembro(fid);
      allow write: if ehAdmin(fid);
    }

    // Cadastro de talhões: operador só lê.
    match /fazendas/{fid}/talhoes/{id} {
      allow read: if ehMembro(fid);
      allow write: if podeExcluir(fid);
    }

    // Quem lê o histórico de alterações e desfaz exclusões/edições. Mantenha igual a AUDITORES em src/firebaseConfig.ts.
    function auditores() {
      return ['marialauragcardoso@gmail.com'];
    }

    // Histórico de alterações: todo membro registra (o app grava a cada alteração); só auditores leem;
    // nunca se apaga. Só se marca como restaurado.
    match /fazendas/{fid}/historico/{id} {
      allow create: if ehMembro(fid);
      allow read: if ehMembro(fid) && email() in auditores();
      allow update: if ehMembro(fid) && email() in auditores()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['restauradoEm', 'restauradoPor']);
      allow delete: if false;
    }

    // Coletas e amostras: todo membro registra e edita; só quem não é operador exclui.
    match /fazendas/{fid}/{col}/{id} {
      allow read, create, update: if ehMembro(fid) && col in ['coletas', 'amostras'];
      allow delete: if podeExcluir(fid) && col in ['coletas', 'amostras'];
    }
  }
}
